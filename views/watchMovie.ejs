<%- include('header') %>

    <div class="container py-5">

        <!-- Trailer Player -->

        <div class="video-player-wrapper">
            <div class="ratio ratio-16x9">

                <iframe src="<%= movie.trailerUrl %>" title="<%= movie.title %>" allowfullscreen>
                </iframe>

            </div>

        </div>

        <!-- Movie Information -->

        <div class="movie-watch-info mt-4">

            <h1>
                <%= movie.title %>
            </h1>

            <div class="movie-meta mt-3">

                <span>
                    ⭐ <%= movie.rating %>/10
                </span>

                <span>
                    🎬 <%= movie.releaseYear %>
                </span>

                <span>
                    ⏱ <%= movie.duration %>
                </span>

                <span>
                    🌍 <%= movie.language %>
                </span>

            </div>

            <div class="mt-4">

                <p>
                    <%= movie.description %>
                </p>

            </div>

            <div class="mt-4">

                <p>
                    <strong>Director:</strong>
                    <%= movie.director %>
                </p>

                <p>
                    <strong>Cast:</strong>
                    <%= movie.cast %>
                </p>

            </div>

            <div class="mt-4 d-flex gap-2">

                <a href="/favorite/<%= movie._id %>" class="btn btn-warning">
                    <% if(movie.isFavorite){ %>
                        ❤️ Saved
                        <% } else { %>
                            🤍 Save Movie
                            <% } %>
                </a>

                <a href="/movie/<%= movie._id %>" class="btn btn-secondary">
                    Movie Details
                </a>

                <a href="/" class="btn btn-outline-light">
                    Back Home
                </a>

            </div>

        </div>

    </div>


    <%- include('footer') %>