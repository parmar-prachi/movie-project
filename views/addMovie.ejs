<%- include('header') %>

    <div class="container py-5">

        <div class="form-container">

            <h2 class="mb-4 text-center">
                Add New Movie
            </h2>

        <form action="/addMovie" method="POST">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label>
                            Movie Title
                        </label>

                        <input type="text" name="title" class="form-control" required>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>
                            Category
                        </label>

                        <select name="category" class="form-control" required>

                            <option>Action</option>
                            <option>Drama</option>
                            <option>Love</option>
                            <option>Comedy</option>
                            <option>Horror</option>
                            <option>Adventure</option>
                            <option>Sci-Fi</option>
                            <option>Thriller</option>

                        </select>

                    </div>

                </div>

                <div class="mb-3">

                    <label>
                        Description
                    </label>

                    <textarea name="description" rows="5" class="form-control" required></textarea>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label>
                            Language
                        </label>

                        <input type="text" name="language" class="form-control" required>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>
                            Duration
                        </label>

                        <input type="text" name="duration" class="form-control" placeholder="2h 15m" required>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label>
                            Release Year
                        </label>

                        <input type="number" name="releaseYear" class="form-control" required>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label>
                            Rating
                        </label>

                        <input type="number" step="0.1" name="rating" class="form-control" required>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label>
                            Director
                        </label>

                        <input type="text" name="director" class="form-control">

                    </div>

                </div>

                <div class="mb-3">

                    <label>
                        Cast
                    </label>

                    <input type="text" name="cast" class="form-control">

                </div>

                <div class="mb-3">

                    <label>
                        Movie Poster URL
                    </label>

                    <input type="url" name="image" class="form-control" placeholder="https://example.com/poster.jpg"
                        required>

                </div>

                <div class="mb-3">

                    <label>
                        Trailer URL
                    </label>

                    <input type="url" name="trailerUrl" class="form-control"
                        placeholder="https://www.youtube.com/watch?v=...">

                </div>

                <button class="btn btn-danger w-100">
                    Add Movie
                </button>

            </form>

        </div>

    </div>

    <%- include('footer') %>