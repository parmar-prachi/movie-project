<%- include('header') %>

    <div class="container py-5">

        <div class="form-container">

            <h2 class="mb-4 text-center">
                Edit Movie
            </h2>

        <form action="/updateMovie/<%= movie._id %>" method="POST">

                <div class="mb-3">

                    <label>
                        Movie Title
                    </label>

                    <input type="text" name="title" value="<%= movie.title %>" class="form-control">

                </div>

                <div class="mb-3">

                    <label>
                        Category
                    </label>

                    <input type="text" name="category" value="<%= movie.category %>" class="form-control">

                </div>

                <div class="mb-3">

                    <label>
                        Description
                    </label>

                    <textarea name="description" class="form-control" rows="5"><%= movie.description %></textarea>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <input type="text" name="language" value="<%= movie.language %>" class="form-control mb-3">

                    </div>

                    <div class="col-md-6">

                        <input type="text" name="duration" value="<%= movie.duration %>" class="form-control mb-3">

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4">

                        <input type="number" name="releaseYear" value="<%= movie.releaseYear %>"
                            class="form-control mb-3">

                    </div>

                    <div class="col-md-4">

                        <input type="number" step="0.1" name="rating" value="<%= movie.rating %>"
                            class="form-control mb-3">

                    </div>

                    <div class="col-md-4">

                        <input type="text" name="director" value="<%= movie.director %>" class="form-control mb-3">

                    </div>

                </div>

                <div class="mb-3">

                    <input type="text" name="cast" value="<%= movie.cast %>" class="form-control">

                </div>
                <div class="mb-3">

                    <label>
                        Change Movie Poster URL
                    </label>

                    <input type="url" name="image" value="<%= movie.image %>" class="form-control"
                        placeholder="https://example.com/poster.jpg">

                </div>

                <div class="mb-3">

                    <label>
                        Change Movie Trailer URL
                    </label>

                    <input type="url" name="trailerUrl" value="<%= movie.trailerUrl %>" class="form-control"
                        placeholder="https://www.youtube.com/watch?v=...">

                </div>

                <button class="btn btn-warning w-100">
                    Update Movie
                </button>

            </form>

        </div>

    </div>

    <%- include('footer') %>